// Druckgrafik (UV-Farbdruck) über die ganze Platte: Bezugspunkt unten links = Plattenursprung
// Parameter 4/5 sind Skalierung X/Y in Prozent – das PDF ist bereits 1:1 in mm (484.717 x 90.339 mm)
var pg = new PrintGraphic("Druckgrafik", "/Users/patrickjoricke/Claude/code/haible-fs1a/frontpanel/fs1a_frontpanel_druck.pdf", refpoint_leftbottom, 100, 100);
fp.AddElement(pg, -1.058, -1.106);

fp.AddElement(new Bolt("S049 Winkel Keystone 633 zum Blech", "GU30", 6), 241.3, 79.75);   // sitzt auf der Rueckseite
fp.AddElement(new Bolt("S050 Winkel Keystone 633 zum Blech", "GU30", 6), 241.3, 8.35);   // sitzt auf der Rueckseite

if (PRINTED) { try { fp.SetPrinted(); } catch (e) { Print("SetPrinted nicht verfügbar\n"); } }
AddFrontpanel(fp);
if (SAVE_AS != "") {
    try { SaveFrontpanel(fp, SAVE_AS, true); Print("Gespeichert: " + SAVE_AS + "\n"); }
    catch (e) { Print("Speichern fehlgeschlagen: " + e + "\n"); }
}
Print("FS-1A Frontpanel: " + fp.Count() + " Elemente\n");
